/* app.wxss —— 全局样式，所有页面共用 */

page {
  background-color: #f6f6f6;
  font-size: 28rpx;
  color: #333;
}

/* 通用卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 通用头像（先用表情代替，之后换成真实头像图片） */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8f7ee;
  color: #07c160;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

/* 空状态提示 */
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
  font-size: 26rpx;
}
