.page {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 24rpx;
  box-sizing: border-box;
}

.lock { padding: 200rpx 0 0; text-align: center; }
.lock-icon { font-size: 96rpx; }
.lock-title { margin-top: 24rpx; color: #999; font-size: 28rpx; }

.head {
  background: linear-gradient(135deg, #07c160, #05a04f);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.head-title { color: #fff; font-size: 38rpx; font-weight: 600; }
.head-desc { margin-top: 12rpx; color: rgba(255,255,255,.85); font-size: 24rpx; line-height: 1.6; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.03);
}

.backup-now { display: flex; align-items: center; justify-content: space-between; }
.backup-now-title { font-size: 30rpx; color: #333; font-weight: 600; }
.backup-now-desc { margin-top: 6rpx; font-size: 22rpx; color: #999; }
.backup-btn {
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
}
.backup-btn.disabled { opacity: .5; }

.empty { text-align: center; padding: 100rpx 0; }
.empty-icon { font-size: 88rpx; }
.empty-title { margin-top: 24rpx; font-size: 30rpx; color: #333; }
.empty-desc { margin-top: 12rpx; font-size: 24rpx; color: #999; }

.bak-card { display: flex; align-items: center; justify-content: space-between; }
.bak-title { font-size: 28rpx; color: #333; font-weight: 500; }
.bak-desc { margin-top: 6rpx; font-size: 22rpx; color: #999; }
.bak-actions { display: flex; gap: 16rpx; }
.bak-copy {
  padding: 8rpx 26rpx;
  border: 2rpx solid #07c160;
  color: #07c160;
  border-radius: 999rpx;
  font-size: 24rpx;
}
.bak-del {
  padding: 8rpx 26rpx;
  border: 2rpx solid #e64340;
  color: #e64340;
  border-radius: 999rpx;
  font-size: 24rpx;
}
.loading { text-align: center; color: #999; font-size: 24rpx; padding: 24rpx 0; }
