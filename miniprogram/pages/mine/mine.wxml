<!-- 我的页面 -->
<view class="page">

  <!-- 顶部个人信息 -->
  <view class="user-card">
    <view class="user-row" bindtap="goProfile">
      <view class="user-info">
        <view class="nickname">{{userInfo ? userInfo.nickname : '未登录同学'}}</view>
        <view class="school">我的大学</view>
      </view>
      <image wx:if="{{hasAvatarImage}}" class="avatar big" src="{{userInfo.avatar}}" mode="aspectFill" />
      <view wx:else class="avatar big">{{userInfo ? userInfo.avatar : '👤'}}</view>
    </view>

    <view class="user-stats">
      <view class="stat-item">
        <view class="stat-num">{{postCount}}</view>
        <view class="stat-label">已发帖</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{likeCount}}</view>
        <view class="stat-label">被点赞</view>
      </view>
      <view class="user-actions">
        <view class="pill light" bindtap="goRules">社区规范</view>
        <view class="pill dark" bindtap="onUserPill">{{userInfo ? '切换社区' : '登录'}}</view>
      </view>
    </view>
  </view>

  <!-- 资料还是默认昵称头像：引导去微信授权 -->
  <view class="auth-card" wx:if="{{isDefaultProfile && userInfo}}" bindtap="goProfile">
    <view class="auth-text">
      <view class="auth-title">🎉 授权微信头像和昵称</view>
      <view class="auth-desc">点一下头像、再点昵称输入框，微信会直接带出你的头像和微信名字</view>
    </view>
    <view class="auth-btn">去授权</view>
  </view>

  <!-- 两列菜单 -->
  <view class="menu-grid">
    <view
      class="menu-item"
      wx:for="{{menus}}"
      wx:key="*this"
      data-name="{{item}}"
      bindtap="onMenuTap"
    >
      <text>{{item}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="uid">uid: {{uid}}</view>
</view>
