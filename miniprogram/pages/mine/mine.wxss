/* 我的页面样式 */

.page {
  padding-bottom: 60rpx;
}

/* 顶部个人信息 */
.user-card {
  background: #fff;
  padding: 40rpx 32rpx 32rpx;
}

.user-row {
  display: flex;
  align-items: center;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 44rpx;
  font-weight: 800;
}

.school {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.avatar.big {
  width: 140rpx;
  height: 140rpx;
  background: #f0faf4;
  color: #07c160;
  font-size: 72rpx;
}

/* 统计数字 */
.user-stats {
  display: flex;
  align-items: flex-end;
  margin-top: 36rpx;
}

.stat-item {
  margin-right: 56rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.user-actions {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.pill {
  font-size: 24rpx;
  padding: 14rpx 30rpx;
  border-radius: 12rpx;
}

.pill.light {
  background: #f5f5f5;
  color: #333;
}

.pill.dark {
  background: #333;
  color: #fff;
}

/* 微信授权头像昵称引导卡 */
.auth-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(90deg, #e8f9ee, #d8f5e3);
  border: 1rpx solid #bfeccf;
  border-radius: 20rpx;
}
.auth-text { flex: 1; min-width: 0; margin-right: 16rpx; }
.auth-title { font-size: 30rpx; font-weight: 600; color: #07a35a; }
.auth-desc { margin-top: 6rpx; font-size: 24rpx; color: #4d6b58; line-height: 1.5; }
.auth-btn {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
}

/* 两列菜单 */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  margin-top: 20rpx;
  padding: 20rpx 32rpx;
}

.menu-item {
  width: 50%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  font-size: 28rpx;
}

.arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-right: 24rpx;
}

/* uid */
.uid {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 60rpx;
}
