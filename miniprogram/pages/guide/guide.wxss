.page {
  padding: 24rpx 24rpx 60rpx;
}

.hero {
  background: linear-gradient(135deg, #0bbf63, #07a35a);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  opacity: 0.92;
}

.hero-chips {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
}

.hero-chip {
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
}

.sec {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 12rpx;
  margin-bottom: 22rpx;
}

.sec-h {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 16rpx;
}

.sec-no {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #e7f8ee;
  color: #07a35a;
  font-size: 24rpx;
  font-weight: 700;
}

.sec-p {
  font-size: 27rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 10rpx;
}

.line {
  display: flex;
  font-size: 27rpx;
  color: #444;
  line-height: 1.7;
  margin-bottom: 10rpx;
}

.dot {
  color: #07c160;
  margin-right: 10rpx;
}

.btn-row {
  padding: 10rpx 0 20rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 34rpx;
  height: 68rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #07a35a;
  background: #e7f8ee;
}

.btn.primary {
  background: linear-gradient(135deg, #0bbf63, #07a35a);
  color: #fff;
  border: none;
}
.btn.primary::after { border: none; }
.btn.ghost {
  background: #fff;
  color: #666;
  border: 1rpx solid #e4e4e4;
}
.btn-hover { opacity: 0.85; }

.link-row {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0 22rpx;
}

.link {
  font-size: 26rpx;
  color: #07a35a;
  margin-right: 28rpx;
  margin-bottom: 10rpx;
}

.qa {
  padding: 6rpx 0 14rpx;
}

.q {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.a {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.foot {
  padding: 12rpx 8rpx 0;
  text-align: center;
}

.foot-text {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 18rpx;
}
