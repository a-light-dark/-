<!-- 个人资料：改昵称、换头像 -->
<view class="page">
  <view class="card">

    <!-- 头像：点按钮用微信的头像能力，或从相册选 -->
    <view class="row">
      <view class="label">头像</view>
      <view class="avatar-cell">
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image wx:if="{{avatarPreview}}" class="avatar-img" src="{{avatarPreview}}" mode="aspectFill" />
          <image wx:elif="{{hasAvatarImage}}" class="avatar-img" src="{{avatar}}" mode="aspectFill" />
          <text wx:else class="avatar-emoji">{{avatar}}</text>
        </button>
        <view class="pick-link" bindtap="onPickImage">从相册选一张 ›</view>
      </view>
    </view>

    <!-- 昵称 -->
    <view class="row">
      <view class="label">昵称</view>
      <input
        class="nickname-input"
        type="nickname"
        value="{{nickname}}"
        maxlength="12"
        placeholder="2-12 个字"
        bindinput="onNicknameInput"
      />
    </view>
  </view>

  <view class="hint">昵称和头像会用来展示你之后发的帖子、评论和互助单；已经发出去的内容保持原样。</view>

  <button class="save-btn" loading="{{saving}}" bindtap="onSave">保存</button>
</view>
