/* 个人资料页 */
.page {
  padding: 20rpx 0 60rpx;
}

.card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.label {
  color: #666;
  width: 120rpx;
}

.avatar-cell {
  display: flex;
  align-items: center;
}

.avatar-btn {
  width: 108rpx;
  height: 108rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #e8f7ee;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  display: block;
}

.avatar-emoji {
  font-size: 52rpx;
}

.pick-link {
  margin-left: 24rpx;
  color: #07c160;
  font-size: 26rpx;
}

.nickname-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
}

.hint {
  color: #999;
  font-size: 24rpx;
  padding: 4rpx 36rpx 0;
  line-height: 1.6;
}

.save-btn {
  margin: 40rpx 32rpx;
  background: #07c160;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.save-btn::after {
  border: none;
}
