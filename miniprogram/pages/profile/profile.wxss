/* 个人资料页 */
.page {
  padding: 24rpx 0 60rpx;
}

.card {
  background: #fff;
  margin: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

/* ---- 头像卡 ---- */
.avatar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx 36rpx;
}

.avatar-wrap {
  position: relative;
  width: 152rpx;
  height: 152rpx;
}

/* button 只当触发器：去掉默认白底/内边距/描边，样式全交给里面的 view */
.avatar-btn {
  width: 152rpx;
  height: 152rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-inner {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: #e8f7ee;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.18);
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-emoji {
  font-size: 76rpx;
  line-height: 1;
}

.avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #e8f7ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.avatar-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #888;
}

.pick-link {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #07c160;
}

/* ---- 昵称卡 ---- */
.row {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.label {
  width: 120rpx;
  color: #666;
  font-size: 30rpx;
}

.nickname-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #222;
}

.nickname-ph {
  color: #bbb;
}

/* ---- 提示 + 保存 ---- */
.hint {
  color: #999;
  font-size: 24rpx;
  padding: 6rpx 36rpx 0;
  line-height: 1.7;
}

.save-btn {
  margin: 48rpx 32rpx 0;
  background: #07c160;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  background: #9be3bd;
  color: #fff;
}
