/* 搜索页样式 */

.page {
  padding: 20rpx 24rpx 40rpx;
}

/* 顶部搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  border: 1rpx solid #e5e5e5;
  padding: 12rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.placeholder {
  color: #bbb;
}

.clear {
  color: #bbb;
  font-size: 26rpx;
  padding: 8rpx 4rpx 8rpx 16rpx;
}

.search-btn {
  flex: none;
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
}

/* 热门 / 历史 */
.section {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.clear-history {
  font-size: 24rpx;
  color: #999;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.chip {
  background: #fff;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #555;
  border: 1rpx solid #eee;
}

/* 结果提示 */
.result-tip {
  margin: 24rpx 4rpx 4rpx;
  font-size: 24rpx;
  color: #999;
}

/* 帖子卡片 */
.post {
  margin-top: 20rpx;
  padding: 24rpx;
}

.post-head {
  display: flex;
  align-items: center;
}

.head-info {
  flex: 1;
  margin-left: 16rpx;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
}

.time {
  font-size: 22rpx;
  color: #999;
}

.post-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.65;
  margin-top: 18rpx;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.post-foot {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.tag-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #666;
  background: #f2f2f2;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.stats {
  display: flex;
  gap: 28rpx;
}

.stat {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 / 加载 */
.empty {
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
  padding: 80rpx 40rpx;
}
