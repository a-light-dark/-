<view class="page">
  <view wx:if="{{checked && !isAdmin}}" class="empty">
    <view class="empty-icon">🔒</view>
    <view class="empty-text">这个页面只有圈主能看</view>
  </view>

  <block wx:if="{{checked && isAdmin}}">
    <view class="search-bar">
      <input class="search-input" placeholder="按内容搜索帖子" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="doSearch" />
      <view class="search-btn" bindtap="doSearch">搜索</view>
      <view wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</view>
    </view>

    <view class="list-head">共 {{total}} 条帖子（按时间倒序）</view>

    <view wx:if="{{loading}}" class="loading-tip">加载中…</view>

    <view wx:for="{{list}}" wx:key="id" class="post-card">
      <view class="post-main" data-id="{{item.id}}" bindtap="goDetail">
        <view class="post-head">
          <text class="post-nick">{{item.nickname}}</text>
          <text wx:if="{{item.anonymous}}" class="badge">匿名</text>
          <text wx:if="{{item.top}}" class="badge top">置顶</text>
        </view>
        <view class="post-content">{{item.content}}</view>
        <view class="post-meta">👍 {{item.likeCount}} · 💬 {{item.commentCount}} · 👀 {{item.views}}</view>
      </view>
      <view class="post-ops">
        <view class="op-btn" data-id="{{item.id}}" data-top="{{item.top}}" bindtap="onTop">{{item.top ? '取消置顶' : '置顶'}}</view>
        <view class="op-btn danger" data-id="{{item.id}}" bindtap="onDelete">删除</view>
      </view>
    </view>

    <view wx:if="{{!loading && !list.length}}" class="empty">
      <view class="empty-icon">📄</view>
      <view class="empty-text">{{keyword ? '没搜到相关内容' : '还没有帖子'}}</view>
    </view>
  </block>
</view>
