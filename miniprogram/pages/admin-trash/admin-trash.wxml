<view class="page">
  <!-- 没权限 -->
  <view class="lock" wx:if="{{checked && !isAdmin}}">
    <view class="lock-icon">🔒</view>
    <view class="lock-title">这个页面只有圈主能看</view>
  </view>

  <block wx:if="{{checked && isAdmin}}">
    <view class="head">
      <view class="head-title">🗑 回收站</view>
      <view class="head-desc">管理员删除的帖子和评论会先进这里，误删可以恢复；彻底删除后找不回来。共 {{total}} 条。</view>
    </view>

    <view class="empty" wx:if="{{!loading && list.length === 0}}">
      <view class="empty-icon">🗑</view>
      <view class="empty-title">回收站是空的</view>
      <view class="empty-desc">在「帖子管理」或「举报处理」里删掉的内容会出现在这里。</view>
      <view class="empty-btn" bindtap="goHome">回首页看看</view>
    </view>

    <view class="card trash-card" wx:for="{{list}}" wx:key="id">
      <view class="trash-top">
        <view class="badge {{item.type === 'comment' ? 'badge-purple' : 'badge-green'}}">{{item.typeName}}</view>
        <view class="trash-time">{{item.time}}</view>
      </view>
      <view class="trash-content">{{item.content || '（没有内容）'}}</view>
      <view class="trash-nick">来自：{{item.nickname}}</view>
      <view class="trash-actions">
        <view class="btn-restore" catchtap="onRestore" data-id="{{item.id}}" data-type="{{item.type}}">恢复</view>
        <view class="btn-purge" catchtap="onPurge" data-id="{{item.id}}">彻底删除</view>
      </view>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中…</view>
  </block>
</view>
