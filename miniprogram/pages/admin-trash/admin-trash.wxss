.page {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 24rpx;
  box-sizing: border-box;
}

.lock {
  padding: 200rpx 0 0;
  text-align: center;
}
.lock-icon { font-size: 96rpx; }
.lock-title { margin-top: 24rpx; color: #999; font-size: 28rpx; }

.head {
  background: linear-gradient(135deg, #07c160, #05a04f);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.head-title { color: #fff; font-size: 38rpx; font-weight: 600; }
.head-desc { margin-top: 12rpx; color: rgba(255,255,255,.85); font-size: 24rpx; line-height: 1.6; }

.empty { text-align: center; padding: 120rpx 0; }
.empty-icon { font-size: 88rpx; }
.empty-title { margin-top: 24rpx; font-size: 30rpx; color: #333; }
.empty-desc { margin: 16rpx auto 0; max-width: 480rpx; font-size: 24rpx; color: #999; line-height: 1.6; }
.empty-btn {
  display: inline-block;
  margin-top: 32rpx;
  padding: 14rpx 48rpx;
  border: 2rpx solid #07c160;
  color: #07c160;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.03);
}
.trash-top { display: flex; align-items: center; justify-content: space-between; }
.badge { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 8rpx; }
.badge-green { background: #e7f8ee; color: #07c160; }
.badge-purple { background: #f3e8fd; color: #9b59b6; }
.trash-time { font-size: 22rpx; color: #bbb; }
.trash-content { margin-top: 16rpx; font-size: 28rpx; color: #333; line-height: 1.6; }
.trash-nick { margin-top: 8rpx; font-size: 24rpx; color: #999; }
.trash-actions { margin-top: 20rpx; display: flex; justify-content: flex-end; gap: 20rpx; }
.btn-restore {
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
}
.btn-purge {
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #e64340;
  color: #e64340;
  font-size: 26rpx;
}
.loading { text-align: center; color: #999; font-size: 24rpx; padding: 24rpx 0; }
