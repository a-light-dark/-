/* pages/review/review.wxss —— 订单评价 */
.card {
  background: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.order-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.order-amount {
  font-size: 40rpx;
  font-weight: 600;
  color: #e6a23c;
}

.order-status {
  font-size: 24rpx;
  color: #07c160;
  background: #e7f8ee;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

.order-content {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.order-people {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
}

.stars {
  display: flex;
  align-items: center;
}

.star {
  font-size: 56rpx;
  color: #e5e5e5;
  margin-right: 12rpx;
  line-height: 1;
}

.star.on {
  color: #ffb800;
}

.score-text {
  font-size: 26rpx;
  color: #999999;
  margin-left: 12rpx;
}

.review-input {
  margin-top: 22rpx;
  width: 100%;
  min-height: 150rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.count {
  text-align: right;
  font-size: 22rpx;
  color: #bbbbbb;
  margin-top: 8rpx;
}

.submit-btn {
  margin-top: 26rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 44rpx;
  height: 84rpx;
  line-height: 84rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #b7e6cb;
  color: #ffffff;
}

.complain-link {
  margin-top: 22rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  text-decoration: underline;
}

.review-line {
  display: flex;
  align-items: flex-start;
}

.review-score {
  font-size: 26rpx;
  color: #ffb800;
  margin-right: 16rpx;
  white-space: nowrap;
}

.review-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  flex: 1;
}

.tip {
  margin: 8rpx 32rpx 40rpx;
  font-size: 22rpx;
  color: #bbbbbb;
  line-height: 1.6;
  text-align: center;
}
