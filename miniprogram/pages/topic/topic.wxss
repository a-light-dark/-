/* pages/topic/topic.wxss —— 话题页样式 */
page {
  background: #f6f6f6;
}

.wrap {
  padding: 20rpx 24rpx 40rpx;
}

/* 话题头 */
.topic-head {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #e7f8ee 0%, #d4f3e1 100%);
  border-radius: 24rpx;
}

.topic-emoji {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 52rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.topic-info {
  flex: 1;
  min-width: 0;
}

.topic-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.topic-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5c6b64;
  line-height: 1.5;
}

.topic-count {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a9a92;
}

.topic-join {
  margin: 0 0 0 16rpx;
  padding: 0 26rpx;
  height: 62rpx;
  line-height: 62rpx;
  font-size: 26rpx;
  color: #fff;
  background: #07c160;
  border-radius: 31rpx;
  flex-shrink: 0;
}

.topic-join::after {
  border: none;
}

/* 右侧两个按钮竖排：参与话题 / 关注 */
.topic-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  flex-shrink: 0;
}

.topic-follow {
  margin: 12rpx 0 0 16rpx;
  padding: 0 26rpx;
  height: 54rpx;
  line-height: 54rpx;
  font-size: 24rpx;
  color: #07c160;
  background: #ffffff;
  border: 1rpx solid #07c160;
  border-radius: 27rpx;
}

.topic-follow::after {
  border: none;
}

.topic-follow.on {
  color: #8a9a92;
  background: #f2f2f2;
  border-color: #d9d9d9;
}

.offline-tip {
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 22rpx;
  color: #b8860b;
  background: #fff8e6;
  border-radius: 14rpx;
}

/* 帖子卡片 */
.post {
  padding: 24rpx 26rpx;
  margin-bottom: 18rpx;
  background: #fff;
  border-radius: 20rpx;
}

.post-head {
  display: flex;
  align-items: center;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 38rpx;
  border-radius: 50%;
  background: #eef7f1;
  overflow: hidden;
  flex-shrink: 0;
}

.post-user {
  margin-left: 16rpx;
}

.nickname {
  font-size: 26rpx;
  color: #333;
}

.time {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #a0a0a0;
}

.content {
  margin: 18rpx 0 0;
  font-size: 28rpx;
  line-height: 1.6;
  color: #222;
  word-break: break-all;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.post-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 18rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

.tag {
  margin: 0 12rpx 6rpx 0;
  padding: 4rpx 14rpx;
  font-size: 21rpx;
  color: #07c160;
  background: #eef8f1;
  border-radius: 20rpx;
}

.stats {
  display: flex;
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.stats text {
  margin-left: 16rpx;
}

.hint,
.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
