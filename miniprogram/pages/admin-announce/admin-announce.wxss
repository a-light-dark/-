.page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 18rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  z-index: 10;
}

.loading-tip {
  color: #999;
  text-align: center;
  padding: 40rpx 0;
}

.ann-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.ann-top {
  display: flex;
  align-items: center;
}

.ann-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  min-width: 0;
}

.badge {
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
}

.badge.pin {
  background: #fff4d6;
  color: #b8860b;
}

.badge.off {
  background: #f0f0f0;
  color: #999;
}

.ann-content {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.ann-ops {
  display: flex;
  margin-top: 16rpx;
}

.op-btn {
  font-size: 24rpx;
  border-radius: 30rpx;
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  border: 1rpx solid #b7e6c9;
  color: #07a35a;
  background: #fff;
}

.op-btn.danger {
  border-color: #f3c5c5;
  color: #e64340;
}

/* 新建面板 */
.compose-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 20;
  display: flex;
  align-items: flex-end;
}

.compose-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.compose-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.compose-input {
  height: 80rpx;
  background: #f6f6f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.compose-textarea {
  width: 100%;
  height: 200rpx;
  background: #f6f6f6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
}

.compose-pin {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-top: 20rpx;
}

.compose-actions {
  display: flex;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 20rpx 0;
}

.btn.ghost {
  background: #f2f2f2;
  color: #666;
  margin-right: 20rpx;
}

.btn.primary {
  background: #07c160;
  color: #fff;
}

.btn.disabled {
  opacity: 0.6;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
  margin-top: 20rpx;
}
