/* 我的收藏 */
.page {
  padding-bottom: 40rpx;
}

.fav {
  padding: 26rpx 28rpx;
}

.fav-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.fav-nick {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.fav-time {
  font-size: 22rpx;
  color: #999;
}

.fav-content {
  font-size: 30rpx;
  color: #222;
  line-height: 1.6;
  margin: 16rpx 0;
}

.fav-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.fav-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  flex: 1;
}

.tag {
  font-size: 22rpx;
  color: #666;
  background: #f2f2f2;
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
}

.fav-counts {
  display: flex;
  gap: 20rpx;
}

.count {
  font-size: 24rpx;
  color: #999;
}

/* 帖子已被删除的占位行 */
.fav.deleted {
  opacity: 0.75;
  background: #fafafa;
}

.fav.deleted .fav-content {
  color: #9aa5b1;
}

.fav.deleted .count {
  color: #c0c8d0;
}
