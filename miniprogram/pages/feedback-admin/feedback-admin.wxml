<!-- 反馈管理（圈主） -->
<view class="page">

  <view wx:if="{{checked && !isAdmin}}" class="empty">
    🔒 这个页面只有圈主能看
  </view>

  <block wx:if="{{isAdmin}}">
    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <view wx:if="{{!loading && list.length === 0}}" class="empty">
      还没有人提交反馈
    </view>

    <view class="fb-card" wx:for="{{list}}" wx:key="id">
      <view class="fb-head">
        <view class="fb-user">
          <image wx:if="{{item.avatarIsImage}}" class="fb-avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view wx:else class="fb-avatar">{{item.avatar}}</view>
          <text class="fb-nick">{{item.nickname}}</text>
          <text class="fb-time">{{item.time}}</text>
        </view>
        <text class="fb-status {{item.done ? 'done' : ''}}">{{item.status}}</text>
      </view>

      <view class="fb-content">{{item.content}}</view>
      <view wx:if="{{item.contact}}" class="fb-contact">联系方式：{{item.contact}}</view>

      <view class="fb-foot">
        <button
          wx:if="{{!item.done}}"
          class="resolve-btn"
          data-id="{{item.id}}"
          catchtap="onResolve"
        >标记已处理</button>
        <text wx:else class="done-tip">已处理</text>
      </view>
    </view>
  </block>

  <view class="foot">反馈来自「我的 → 建议反馈」，处理状态会同步给提交人。</view>
</view>
