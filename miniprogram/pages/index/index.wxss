/* 首页样式 */

.page {
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx 0;
}

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  border: 1rpx solid #e5e5e5;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

/* 分类入口 */
.quick-entry {
  display: flex;
  justify-content: space-between;
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 26rpx 12rpx;
}

.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #f4f8f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.entry-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #333;
}

/* 选中的分类入口 */
.entry.active .entry-icon {
  background: #e7f8ee;
  box-shadow: inset 0 0 0 2rpx #07c160;
}

.entry.active .entry-name {
  color: #07c160;
  font-weight: 600;
}

/* 分类筛选提示条 */
.filter-bar {
  margin: 16rpx 24rpx 0;
}

.filter-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #e7f8ee;
  color: #07a04a;
  font-size: 24rpx;
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
}

.filter-clear {
  color: #07c160;
  font-weight: 600;
}

/* 今日热榜 */
.hot-row {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.hot-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.hot-tag {
  flex-shrink: 0;
  color: #ff4d4f;
  font-weight: 600;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.hot-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hot-more {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #07c160;
  background: #eef8f1;
  border-radius: 20rpx;
}

/* 公告 banner */
.banner {
  margin: 20rpx 24rpx 0;
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  background: linear-gradient(120deg, #8b5cf6, #6d28d9);
  color: #fff;
}

.banner-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffe9a8;
}

.banner-desc {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}

/* 热门话题运营位（横向滚动小卡） */
.topic-strip {
  white-space: nowrap;
  padding: 20rpx 24rpx 0;
}

.topic-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-right: 16rpx;
  padding: 12rpx 20rpx;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.topic-chip-hover {
  background: #f2f2f2;
}

.topic-chip-emoji {
  font-size: 24rpx;
}

.topic-chip-name {
  font-size: 24rpx;
  color: #333;
}

.topic-chip-count {
  font-size: 20rpx;
  color: #07c160;
  background: #e8f7ee;
  padding: 0 10rpx;
  border-radius: 999rpx;
}

/* 分类 tab（横向滚动） */
.tabs {
  background: #fff;
  margin-top: 20rpx;
  padding: 0 24rpx;
  white-space: nowrap;
}

.tab {
  display: inline-block;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.tab.active {
  color: #111;
  font-weight: 600;
  border-bottom-color: #07c160;
}

/* 排序条：最新 / 最热 / 浏览 */
.sort-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
}

.sort-chip {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f4f5f4;
  color: #666;
  font-size: 24rpx;
}

.sort-chip.active {
  background: #e7f8ee;
  color: #07a35a;
  font-weight: 600;
}

/* 帖子卡片 */
.post {
  background: #fff;
  margin-top: 20rpx;
  padding: 24rpx;
}

.post-head {
  display: flex;
  align-items: center;
}

.head-info {
  flex: 1;
  margin-left: 16rpx;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
}

.time {
  font-size: 22rpx;
  color: #999;
}

.post-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.65;
  margin-top: 18rpx;
}

.post-foot {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.tag-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #666;
  background: #f2f2f2;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.stats {
  display: flex;
  gap: 28rpx;
}

.stat {
  font-size: 24rpx;
  color: #999;
}

/* 帖子里的图片（九宫格风格，点开放大） */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

/* 首次进入的隐私提示 */
.privacy-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.privacy-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 28rpx;
  box-sizing: border-box;
}

.privacy-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2933;
  text-align: center;
  margin-bottom: 20rpx;
}

.privacy-body {
  font-size: 26rpx;
  color: #55606b;
  line-height: 1.8;
}

.privacy-link {
  color: #07c160;
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.privacy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  border-radius: 42rpx;
  padding: 0;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn.ghost {
  background: #f2f4f6;
  color: #66727d;
}

.privacy-btn.primary {
  background: #07c160;
  color: #ffffff;
  font-weight: 600;
}

/* 点卡片时的按下反馈：让点击「有响应」 */
.post-hover {
  background: #f3f3f3;
}

/* 首屏骨架屏（比空白 + 加载中稳，减少闪烁） */
.skeleton {
  padding: 0 24rpx;
}
.sk-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.sk-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.sk-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eeeeee;
  margin-right: 16rpx;
}
.sk-line {
  height: 26rpx;
  border-radius: 8rpx;
  background: #eeeeee;
  margin-bottom: 16rpx;
  animation: sk-breathe 1.2s ease-in-out infinite;
}
.sk-line-short {
  width: 180rpx;
  margin-bottom: 0;
}
.sk-line-mid {
  width: 60%;
  margin-bottom: 0;
}
@keyframes sk-breathe {
  0% { opacity: 1; }
  50% { opacity: 0.55; }
  100% { opacity: 1; }
}
