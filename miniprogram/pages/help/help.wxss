/* 互助大厅样式 */

.page {
  padding-bottom: 40rpx;
}

/* 顶部说明 */
.hall-head {
  padding: 36rpx 32rpx 24rpx;
}

.hall-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hall-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.action-btn.primary {
  background: #07c160;
  color: #fff;
}

.action-btn.ghost {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
}

/* 分类 tab */
.tabs {
  display: flex;
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 26rpx;
  color: #666;
}

.tab.active {
  color: #07c160;
  font-weight: 600;
  background: #e8f7ee;
}

/* 订单卡片 */
.order {
  background: #fff;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 24rpx;
}

.order-head {
  display: flex;
  align-items: center;
}

.head-info {
  flex: 1;
  margin-left: 16rpx;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
}

.time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 订单状态 */
.status {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  border: 1rpx solid;
}

.status.pending {
  color: #ff9500;
  border-color: #ff9500;
  background: #fff7e6;
}

.status.taken {
  color: #4a90e2;
  border-color: #4a90e2;
  background: #eef5ff;
}

.status.done {
  color: #07c160;
  border-color: #07c160;
  background: #e8f7ee;
}

.status.confirming {
  color: #9b59b6;
  border-color: #9b59b6;
  background: #f6eefb;
}

.status.cancelled {
  color: #999;
  border-color: #999;
  background: #f2f2f2;
}

.order-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-top: 16rpx;
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.amount {
  color: #ff4d4f;
  font-size: 26rpx;
  font-weight: 600;
}

.grab-btn {
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 36rpx;
  border-radius: 8rpx;
}

.grab-btn.wait {
  background: #f6eefb;
  color: #9b59b6;
}

.grab-btn.confirm {
  background: #fff7e6;
  color: #ff9500;
}

.grab-btn.cancel {
  background: #f2f2f2;
  color: #999;
}

.order-taker {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #888;
}

/* 点订单卡时的按下反馈 */
.order-hover {
  background: #f3f3f3;
}
