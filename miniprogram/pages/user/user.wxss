/* pages/user/user.wxss —— 个人主页 */
.profile-head {
  background: linear-gradient(160deg, #07c160, #0aa84f);
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.big-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.6);
}

.profile-name {
  margin-top: 20rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #ffffff;
}

.profile-tag {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.profile-stats {
  display: flex;
  margin-top: 28rpx;
  width: 100%;
}

.ps {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ps-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.ps-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.edit-btn {
  margin-top: 28rpx;
  background: #ffffff;
  color: #07c160;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0 36rpx;
  height: 60rpx;
  line-height: 60rpx;
  border: none;
}

.edit-btn::after {
  border: none;
}

.sec-title {
  margin: 24rpx 24rpx 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.post {
  background: #ffffff;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.post-content {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.6;
  word-break: break-all;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin: 0 10rpx 10rpx 0;
  background: #f2f2f2;
}

.post-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  flex: 1;
}

.tag {
  font-size: 22rpx;
  color: #07c160;
  background: #e7f8ee;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  margin: 0 8rpx 6rpx 0;
}

.stats {
  display: flex;
  align-items: center;
}

.stat {
  font-size: 22rpx;
  color: #999999;
  margin-left: 16rpx;
}

.empty-actions {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 40rpx;
}

.empty-btn {
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0bbf63, #07a35a);
  color: #fff;
  font-size: 28rpx;
}

