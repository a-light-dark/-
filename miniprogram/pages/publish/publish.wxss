/* 发帖页样式 */

.page {
  padding: 20rpx 30rpx;
}

/* ── 选类型 ── */
.chooser-title {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin: 40rpx 0 50rpx;
}

.type-card {
  display: flex;
  align-items: center;
  background: #f7f7f7;
  border-radius: 20rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 28rpx;
}

.type-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.type-text {
  flex: 1;
  margin-left: 24rpx;
}

.type-name {
  font-size: 32rpx;
  font-weight: 700;
}

.type-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.arrow {
  font-size: 44rpx;
  color: #ccc;
}

/* ── 返回 ── */
.back-row {
  font-size: 26rpx;
  color: #07c160;
  margin: 16rpx 0 24rpx;
}

/* ── 输入区 ── */
.content-input {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  width: 100%;
  height: 300rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.7;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  margin: 32rpx 0 16rpx;
}

/* 图片选择 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-cell {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  color: #fff;
  font-size: 30rpx;
  background: rgba(0, 0, 0, 0.45);
  border-bottom-left-radius: 16rpx;
}

.image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #ccc;
  border: 1rpx dashed #ddd;
  box-sizing: border-box;
}

/* 话题 */
.topics {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic {
  padding: 12rpx 30rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #eee;
}

.topic.active {
  background: #e8f7ee;
  color: #07c160;
  border-color: #07c160;
}

/* 匿名开关 */
.anon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-top: 28rpx;
}

.anon-title {
  font-size: 28rpx;
  font-weight: 600;
}

.anon-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 金额 */
.amount-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.yuan {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff4d4f;
  margin-right: 12rpx;
}

.amount-input {
  flex: 1;
  font-size: 30rpx;
}

/* 发布按钮 */
.submit-btn {
  margin-top: 48rpx;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.submit-btn::after {
  border: none;
}
