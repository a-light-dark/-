/* pages/board/board.wxss —— 本周榜单样式 */
page {
  background: #f6f6f6;
}

.wrap {
  padding: 24rpx 24rpx 48rpx;
}

.head {
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #07c160 0%, #0aa85a 100%);
  border-radius: 24rpx;
  color: #fff;
}

.head-title {
  font-size: 36rpx;
  font-weight: 600;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.offline-tip {
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 22rpx;
  color: #b8860b;
  background: #fff8e6;
  border-radius: 14rpx;
}

.sec {
  padding: 8rpx 26rpx 22rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
}

.sec-title {
  padding: 22rpx 0 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.sec-sub {
  font-size: 21rpx;
  color: #a0a0a0;
  margin-bottom: 8rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f3f3;
}

.row:last-child {
  border-bottom: none;
}

.rank {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin-right: 16rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #b0b0b0;
  background: #f5f5f5;
  border-radius: 50%;
  flex-shrink: 0;
}

.rank-top {
  color: #fff;
  background: linear-gradient(135deg, #ffb02e 0%, #ff8a00 100%);
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 34rpx;
  border-radius: 50%;
  background: #eef7f1;
  overflow: hidden;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-text {
  font-size: 27rpx;
  color: #222;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.row-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.dot {
  margin: 0 8rpx;
}

.hint {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}
