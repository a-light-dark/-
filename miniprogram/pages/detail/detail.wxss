/* 帖子详情页样式 */

.page {
  padding-bottom: 40rpx;
}

.post-head {
  display: flex;
  align-items: center;
}

.head-info {
  flex: 1;
  margin-left: 16rpx;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
}

.time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  margin-top: 20rpx;
}

.post-foot {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.tag-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #666;
  background: #f2f2f2;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.stats {
  display: flex;
  gap: 28rpx;
}

.stat {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  transition: transform 0.15s ease, color 0.15s ease, background 0.15s ease;
}

/* 已点赞 / 已收藏：绿色 + 轻微放大，点下去看得见变化 */
.stat.on {
  color: #07c160;
  font-weight: 600;
  background: #e8f7ee;
  transform: scale(1.06);
}

.stat-hover {
  background: #f2f2f2;
}

/* 分享 / 删除 / 举报 */
.post-extra {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.extra-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.extra-btn {
  font-size: 24rpx;
  color: #999;
}

/* 分享按钮：去掉小程序 button 默认样式 */
.share-btn {
  display: inline-flex;
  align-items: center;
  margin: 0;
  padding: 8rpx 26rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #07a04a;
  background: #e7f8ee;
  border-radius: 999rpx;
  border: none;
}

.share-btn::after {
  border: none;
}

.extra-danger {
  color: #e64340;
}

/* 编辑：低调的绿色文字按钮 */
.extra-edit {
  color: #07a35a;
  margin-right: 24rpx;
}

/* 评论 */
.comments-title {
  font-size: 26rpx;
  color: #999;
  margin: 30rpx 30rpx 0;
}

/* 长按提示：浅灰小字，不抢内容注意力 */
.mini-tip {
  font-size: 22rpx;
  color: #bbb;
  margin: 8rpx 30rpx 0;
}

.comment {
  display: flex;
  gap: 16rpx;
}

.comment-body {
  flex: 1;
}

.comment-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.comment-content {
  font-size: 28rpx;
  color: #444;
  margin-top: 8rpx;
  line-height: 1.6;
}

/* 底部输入栏 */
.bottom-space {
  height: 120rpx;
}

.input-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 正在回复某人时的提示条 */
.reply-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 28rpx 0;
  font-size: 24rpx;
  color: #07a35a;
}

.reply-cancel {
  color: #999;
}

.input-bar {
  background: #fff;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input {
  flex: 1;
  background: #f2f2f2;
  border-radius: 34rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #07c160;
  color: #fff;
  padding: 14rpx 36rpx;
  border-radius: 34rpx;
  font-size: 28rpx;
  transition: background 0.15s ease;
}

.send-hover {
  background: #06ad56;
}

/* 帖子图片：详情里竖着排，宽度撑满 */
.post-images {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* 帖子图片：详情里竖着排，宽度撑满；右下角加「校园圈」水印 */
.post-image-wrap {
  position: relative;
  line-height: 0;
}

.post-image {
  width: 100%;
  border-radius: 16rpx;
  background: #f2f2f2;
  display: block;
}

.wm {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

/* 帖子不存在时的出口 */
.missing-actions {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 40rpx;
}

.missing-btn {
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0bbf63, #07a35a);
  color: #fff;
  font-size: 28rpx;
}

/* ===== 楼中楼评论 ===== */
.comment-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 10rpx;
}

.reply-link {
  font-size: 24rpx;
  color: #07a35a;
}

.reply-count {
  font-size: 22rpx;
  color: #999;
}

.replies {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  background: #f7f8f7;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reply-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.reply-body {
  flex: 1;
  min-width: 0;
}

.reply-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.reply-to {
  font-size: 22rpx;
  color: #07a35a;
}

.avatar.small {
  width: 48rpx;
  height: 48rpx;
  font-size: 26rpx;
  line-height: 48rpx;
}


