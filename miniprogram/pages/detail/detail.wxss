/* 帖子详情页样式 */

.page {
  padding-bottom: 40rpx;
}

.post-head {
  display: flex;
  align-items: center;
}

.head-info {
  flex: 1;
  margin-left: 16rpx;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
}

.time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  margin-top: 20rpx;
}

.post-foot {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.tag-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #666;
  background: #f2f2f2;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.stats {
  display: flex;
  gap: 28rpx;
}

.stat {
  font-size: 24rpx;
  color: #999;
}

/* 分享 / 删除 / 举报 */
.post-extra {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.extra-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.extra-btn {
  font-size: 24rpx;
  color: #999;
}

/* 分享按钮：去掉小程序 button 默认样式 */
.share-btn {
  display: inline-flex;
  align-items: center;
  margin: 0;
  padding: 8rpx 26rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #07a04a;
  background: #e7f8ee;
  border-radius: 999rpx;
  border: none;
}

.share-btn::after {
  border: none;
}

.extra-danger {
  color: #e64340;
}

/* 评论 */
.comments-title {
  font-size: 26rpx;
  color: #999;
  margin: 30rpx 30rpx 0;
}

.comment {
  display: flex;
  gap: 16rpx;
}

.comment-body {
  flex: 1;
}

.comment-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.comment-content {
  font-size: 28rpx;
  color: #444;
  margin-top: 8rpx;
  line-height: 1.6;
}

/* 底部输入栏 */
.bottom-space {
  height: 120rpx;
}

.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.input {
  flex: 1;
  background: #f2f2f2;
  border-radius: 34rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #07c160;
  color: #fff;
  padding: 14rpx 36rpx;
  border-radius: 34rpx;
  font-size: 28rpx;
}

/* 帖子图片：详情里竖着排，宽度撑满 */
.post-images {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.post-image {
  width: 100%;
  border-radius: 16rpx;
  background: #f2f2f2;
}
